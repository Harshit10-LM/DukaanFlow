SECRET_KEY=replace-with-a-long-random-value
FLASK_ENV=development
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=dukaanflow
GEMMA_API_KEY=your-gemma-api-key
GEMMA_MODEL=gemma-4-26b-a4b-it
# ElevenLabs text-to-speech (optional — order management works without it)
# ELEVENLABS_API_KEY : your API key from https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_VOICE_ID: voice ID from https://elevenlabs.io/app/voice-lab (e.g. Rachel: 21m00Tcm4TlvDq8ikWAM)
# ELEVENLABS_MODEL_ID: eleven_multilingual_v2 (English+Hindi, 29 languages) or eleven_v3 (70+ languages)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-voice-id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
